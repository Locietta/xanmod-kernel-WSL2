From 43bf3f4736a74f2df42e98acaba3d3bfab702bfe Mon Sep 17 00:00:00 2001
From: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
Date: Fri, 4 Sep 2026 21:59:52 +0000
Subject: [PATCH 2/9] Drivers: hv: vmbus: fix the rescind ownership protocol
 for sub channels

vmbus_disconnect_ring() waits for rescind_event on every rescinded sub
channel, but vmbus_onoffer_rescind() only completes that event for one
that is still open; otherwise it frees the channel itself and the closer
waits forever.  A sub channel is left in CHANNEL_OPEN_STATE on sc_list
when its vmbus_open() fails, which hot removing a vNIC during sub channel
setup hits easily.  The hang takes RTNL with it:

  task:kworker/u129:10 state:D
  Workqueue: hv_vmbus_rescind vmbus_onmessage_work
   wait_for_completion+0x83/0x120
   vmbus_disconnect_ring+0xa9/0x120
   vmbus_close+0x17/0x40
   netvsc_device_remove+0x15b/0x230 [hv_netvsc]
   rndis_filter_device_remove+0x195/0x3d0 [hv_netvsc]
   netvsc_remove+0x153/0x210 [hv_netvsc]
   vmbus_device_unregister+0x28/0x70
   vmbus_onoffer_rescind+0x21e/0x250

  task:kworker/0:2 state:D
  Workqueue: hv_pri_chan vmbus_add_channel_work
   rtnl_lock+0x19/0x20
   netvsc_probe+0x299/0x620 [hv_netvsc]
   vmbus_add_channel_work+0x140/0x1c0

The channel state cannot decide ownership, because it is not stable: a
sub channel in CHANNEL_OPENING_STATE moves to CHANNEL_OPEN_STATE on the
__vmbus_open() error path once channel_mutex is dropped.  Claim the
channel explicitly with closer_owns in the same critical section that
inspects it; the rescind handler and the error path of
vmbus_add_channel_work() then only complete rescind_event, and the closer
frees the rescinded channels itself so their relids are released.
closer_owns is also the visited marker, so sc_list can be re-read on
every round rather than caching a next pointer across the sleep.

Fixes: 7fa32e5ec28b ("Drivers: hv: vmbus: Fix a rescind issue")
Fixes: 192b2d78722f ("Drivers: hv: vmbus: Fix bugs in rescind handling")
Signed-off-by: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
---
 drivers/hv/channel.c      | 71 +++++++++++++++++++++++++++++++++++----
 drivers/hv/channel_mgmt.c | 24 ++++++++-----
 include/linux/hyperv.h    |  7 ++++
 3 files changed, 88 insertions(+), 14 deletions(-)

diff --git a/drivers/hv/channel.c b/drivers/hv/channel.c
index a0883ddf32e2..1a3038a0635d 100644
--- a/drivers/hv/channel.c
+++ b/drivers/hv/channel.c
@@ -1159,6 +1159,33 @@ static int vmbus_close_internal(struct vmbus_channel *channel)
 	return ret;
 }
 
+/*
+ * Claim the next sub channel that has not been visited yet, or NULL once all
+ * of them have been.
+ *
+ * The list is re-read on every round because the caller sleeps, and both
+ * vmbus_onoffer_rescind() and the error path of vmbus_add_channel_work()
+ * remove entries meanwhile, so a cached next pointer can be freed.
+ * closer_owns is both the claim and the visited marker: while it is set,
+ * neither of those paths frees the channel.
+ */
+static struct vmbus_channel *vmbus_claim_next_sc(struct vmbus_channel *primary)
+{
+	struct vmbus_channel *sc, *claimed = NULL;
+
+	mutex_lock(&vmbus_connection.channel_mutex);
+	list_for_each_entry(sc, &primary->sc_list, sc_list) {
+		if (!sc->closer_owns) {
+			sc->closer_owns = true;
+			claimed = sc;
+			break;
+		}
+	}
+	mutex_unlock(&vmbus_connection.channel_mutex);
+
+	return claimed;
+}
+
 /* disconnect ring - close all channels */
 int vmbus_disconnect_ring(struct vmbus_channel *channel)
 {
@@ -1168,20 +1195,52 @@ int vmbus_disconnect_ring(struct vmbus_channel *channel)
 	if (channel->primary_channel != NULL)
 		return -EINVAL;
 
-	list_for_each_entry_safe(cur_channel, tmp, &channel->sc_list, sc_list) {
-		if (cur_channel->rescind)
+	while ((cur_channel = vmbus_claim_next_sc(channel)) != NULL) {
+		if (cur_channel->rescind) {
+			/*
+			 * The channel is claimed, so the rescind handler only
+			 * completes rescind_event rather than freeing it, and
+			 * this wait always makes progress.
+			 */
 			wait_for_completion(&cur_channel->rescind_event);
+		}
 
 		mutex_lock(&vmbus_connection.channel_mutex);
-		if (vmbus_close_internal(cur_channel) == 0) {
+
+		ret = vmbus_close_internal(cur_channel);
+		if (ret == 0)
 			vmbus_free_ring(cur_channel);
 
-			if (cur_channel->rescind)
-				hv_process_channel_removal(cur_channel);
-		}
+		/*
+		 * Free a rescinded channel here, including one the close
+		 * refused because it was never open: the rescind handler left
+		 * the teardown to this thread, and missing it leaks the relid,
+		 * so the next hot-add of the device fails.
+		 */
+		if (cur_channel->rescind)
+			hv_process_channel_removal(cur_channel);
+
 		mutex_unlock(&vmbus_connection.channel_mutex);
 	}
 
+	/*
+	 * Release the claim on the sub channels still listed.  A rescind
+	 * arriving from here on has to be free to tear them down itself; one
+	 * that arrived while they were claimed only completed rescind_event,
+	 * so those are freed here.
+	 */
+	mutex_lock(&vmbus_connection.channel_mutex);
+	list_for_each_entry_safe(cur_channel, tmp, &channel->sc_list, sc_list) {
+		if (!cur_channel->closer_owns)
+			continue;
+
+		if (cur_channel->rescind)
+			hv_process_channel_removal(cur_channel);
+		else
+			cur_channel->closer_owns = false;
+	}
+	mutex_unlock(&vmbus_connection.channel_mutex);
+
 	/*
 	 * Now close the primary.
 	 */
diff --git a/drivers/hv/channel_mgmt.c b/drivers/hv/channel_mgmt.c
index bccfbd4dd664..3e754a638668 100644
--- a/drivers/hv/channel_mgmt.c
+++ b/drivers/hv/channel_mgmt.c
@@ -578,14 +578,15 @@ static void vmbus_add_channel_work(struct work_struct *work)
 	newchannel->probe_done = true;
 
 	/*
-	 * If vmbus_onoffer_rescind() has already claimed this channel it
-	 * removes and frees it once it observes probe_done above, so doing
-	 * that here as well would do both twice.  Only a sub channel can be
-	 * handed over: for a primary channel the rescind handler has nothing
-	 * to remove it with, because device_obj is either NULL or already
-	 * gone by this point.
+	 * If vmbus_onoffer_rescind() has claimed this channel it frees it once
+	 * it observes probe_done above, and if vmbus_disconnect_ring() has
+	 * claimed it, it tears it down itself; freeing it here would do it
+	 * twice, or leave the closer on freed memory.  Only a sub channel can
+	 * be handed over: for a primary channel the rescind handler has nothing
+	 * to remove it with.
 	 */
-	if (primary_channel != NULL && newchannel->rescind_ref) {
+	if (primary_channel != NULL &&
+	    (newchannel->rescind_ref || newchannel->closer_owns)) {
 		mutex_unlock(&vmbus_connection.channel_mutex);
 		return;
 	}
@@ -1297,7 +1298,14 @@ static void vmbus_onoffer_rescind(struct vmbus_channel_message_header *hdr)
 		 * 2. Then close the primary channel.
 		 */
 		mutex_lock(&vmbus_connection.channel_mutex);
-		if (channel->state == CHANNEL_OPEN_STATE) {
+		if (channel->closer_owns) {
+			/*
+			 * The closer has claimed this channel and tears it
+			 * down itself; freeing it here would leave it on freed
+			 * memory.  Publish the completion instead.
+			 */
+			complete(&channel->rescind_event);
+		} else if (channel->state == CHANNEL_OPEN_STATE) {
 			/*
 			 * The channel is currently not open;
 			 * it is safe for us to cleanup the channel.
diff --git a/include/linux/hyperv.h b/include/linux/hyperv.h
index a0392c0ab69c..7371b5759189 100644
--- a/include/linux/hyperv.h
+++ b/include/linux/hyperv.h
@@ -801,6 +801,13 @@ struct vmbus_channel {
 
 	bool rescind; /* got rescind msg */
 	bool rescind_ref; /* got rescind msg, got channel reference */
+	/*
+	 * Set by vmbus_disconnect_ring() under channel_mutex to claim a sub
+	 * channel and mark it visited.  While it is set the channel must not
+	 * be freed by anyone else; the rescind handler only completes
+	 * rescind_event and leaves the teardown to the closer.
+	 */
+	bool closer_owns;
 	struct completion rescind_event;
 
 	struct vmbus_gpadl ringbuffer_gpadlhandle;
-- 
