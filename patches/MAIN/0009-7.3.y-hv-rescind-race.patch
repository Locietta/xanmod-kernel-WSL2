From 7475e9f24272a9536ec16c70ec93435d90d18ad3 Mon Sep 17 00:00:00 2001
From: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
Date: Fri, 4 Sep 2026 21:45:22 +0000
Subject: [PATCH 4/9] Drivers: hv: vmbus: fix double kobject_put() on the
 channel setup error path

vmbus_add_channel_kobj() drops the channel's kobject reference when
kobject_init_and_add() or sysfs_create_group() fails.  Both callers then
propagate the error to the err_deq_chan path of vmbus_add_channel_work(),
which calls free_channel() and drops the reference a second time.  The
first put already takes the reference to zero, so the channel is handed to
kfree_rcu() and everything err_deq_chan does afterwards, including
vmbus_release_relid(), is a use after free:

  kobject: kobject_add_internal failed for 49 (error: -2 parent: channels)
  kernfs: can not remove 'out_mask', no directory
  WARNING: fs/kernfs/dir.c:1785 at kernfs_remove_by_name_ns+0xda/0xf0
  Workqueue: hv_sub_chan vmbus_add_channel_work
   sysfs_remove_group+0x46/0xa0
   vmbus_remove_channel_attr_group+0x20/0x30
   vmbus_add_channel_work+0xcb/0x1a0
  [ ... one such splat per attribute in the group ... ]
  refcount_t: underflow; use-after-free.
  WARNING: lib/refcount.c:28 at refcount_warn_saturate+0x60/0x90
   kobject_put+0x148/0x220
   vmbus_add_channel_work+0xd4/0x1a0

kobject_add_internal() fails with -ENOENT when the parent "channels" kset
has already been unregistered, i.e. when the host rescinds the device
while a sub channel offer is still being processed.  Leave the reference
to the caller instead: both callers reach free_channel(), so it is
released exactly once and the channel stays valid for the rest of the
error path.  When sysfs_create_group() fails the directory created by
kobject_init_and_add() must still be removed, so call kobject_del() there,
and free_channel() must stop removing an attribute group that was never
created; use kobj.state_in_sysfs to tell the two cases apart.

Fixes: 8bc69f86328e ("Drivers: hv: vmbus: Fix memory leak in vmbus_add_channel_kobj")
Signed-off-by: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
---
 drivers/hv/channel_mgmt.c |  9 ++++++++-
 drivers/hv/vmbus_drv.c    | 11 +++++++----
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/drivers/hv/channel_mgmt.c b/drivers/hv/channel_mgmt.c
index 3e754a638668..800da63f3824 100644
--- a/drivers/hv/channel_mgmt.c
+++ b/drivers/hv/channel_mgmt.c
@@ -377,7 +377,14 @@ static struct vmbus_channel *alloc_channel(void)
 static void free_channel(struct vmbus_channel *channel)
 {
 	tasklet_kill(&channel->callback_event);
-	vmbus_remove_channel_attr_group(channel);
+
+	/*
+	 * The attribute group only exists if vmbus_add_channel_kobj()
+	 * completed successfully.  Removing it otherwise makes kernfs
+	 * complain about every attribute in the group.
+	 */
+	if (channel->kobj.state_in_sysfs)
+		vmbus_remove_channel_attr_group(channel);
 
 	kobject_put(&channel->kobj);
 }
diff --git a/drivers/hv/vmbus_drv.c b/drivers/hv/vmbus_drv.c
index 4692687cdbf3..7320dcf12649 100644
--- a/drivers/hv/vmbus_drv.c
+++ b/drivers/hv/vmbus_drv.c
@@ -2098,7 +2098,10 @@ int vmbus_add_channel_kobj(struct hv_device *dev, struct vmbus_channel *channel)
 	ret = kobject_init_and_add(kobj, &vmbus_chan_ktype, NULL,
 				   "%u", relid);
 	if (ret) {
-		kobject_put(kobj);
+		/*
+		 * The channel reference is dropped by the caller's error
+		 * handling path, which calls free_channel().
+		 */
 		return ret;
 	}
 
@@ -2106,10 +2109,10 @@ int vmbus_add_channel_kobj(struct hv_device *dev, struct vmbus_channel *channel)
 
 	if (ret) {
 		/*
-		 * The calling functions' error handling paths will cleanup the
-		 * empty channel directory.
+		 * Remove the empty channel directory here; the channel
+		 * reference is dropped by the caller's error handling path.
 		 */
-		kobject_put(kobj);
+		kobject_del(kobj);
 		dev_err(device, "Unable to set up channel sysfs files\n");
 		return ret;
 	}
-- 
2.56.0


From d190283aee30378c1a390fdb8f14193fc53eccd8 Mon Sep 17 00:00:00 2001
From: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
Date: Fri, 4 Sep 2026 21:45:23 +0000
Subject: [PATCH 5/9] net: hv_netvsc: abort primary channel NVSP waits on
 rescind

The NVSP setup exchanges in netvsc.c wait for the host with a bare
wait_for_completion() on net_device->channel_init_wait.  Once the primary
vmbus channel is rescinded, e.g. because the vNIC is being hot-removed,
the host stops processing the ring buffer, so the response never arrives
and the wait never returns.  These waits run below netvsc_device_add(),
which netvsc_probe() calls with RTNL held, so blocking there also prevents
the rescind handler from taking RTNL in netvsc_remove(), and the guest
never sends CHANNELMSG_RELID_RELEASED back to the host:

  task:kworker/0:2 state:D
  Workqueue: hv_pri_chan vmbus_add_channel_work
   wait_for_completion+0x8a/0x120
   netvsc_device_add+0x3f7/0x600 [hv_netvsc]
   rndis_filter_device_add+0xff/0x8a0 [hv_netvsc]
   netvsc_probe+0x1e9/0x620 [hv_netvsc]
   vmbus_device_register+0x96/0x140

  task:kworker/u129:2 state:D
  Workqueue: hv_vmbus_rescind vmbus_onmessage_work
   rtnl_lock+0x19/0x20
   netvsc_remove+0x3f/0x210 [hv_netvsc]
   vmbus_device_unregister+0x28/0x70
   vmbus_onoffer_rescind+0x21e/0x250

Setting of chan->rescind by the vmbus driver does not wake the completion,
so add a netvsc_wait_for_nvsp_response() helper that polls it with a
timeout and gives up with -ENODEV once the channel is rescinded, and use
it for the NVSP version negotiation, the NDIS version exchange, the
receive and send buffer setup in netvsc_init_buf(), and the data path
switch in netvsc_switch_datapath().

Signed-off-by: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
---
 drivers/net/hyperv/netvsc.c | 34 ++++++++++++++++++++++++++++++----
 1 file changed, 30 insertions(+), 4 deletions(-)

diff --git a/drivers/net/hyperv/netvsc.c b/drivers/net/hyperv/netvsc.c
index 5cd084e5696c..3bc7c1b5a505 100644
--- a/drivers/net/hyperv/netvsc.c
+++ b/drivers/net/hyperv/netvsc.c
@@ -31,6 +31,23 @@
 
 static struct workqueue_struct *netvsc_wq;
 
+static int netvsc_wait_for_nvsp_response(struct hv_device *device,
+					 struct netvsc_device *net_device)
+{
+	struct net_device *ndev = hv_get_drvdata(device);
+
+	while (!wait_for_completion_timeout(&net_device->channel_init_wait, HZ)) {
+		if (device->channel->rescind) {
+			netdev_err(ndev,
+				   "NVSP message 0x%x aborted, channel rescinded\n",
+				   net_device->channel_init_pkt.hdr.msg_type);
+			return -ENODEV;
+		}
+	}
+
+	return 0;
+}
+
 /*
  * Switch the data path from the synthetic interface to the VF
  * interface.
@@ -87,7 +104,10 @@ int netvsc_switch_datapath(struct net_device *ndev, bool vf)
 		}
 	}
 
-	wait_for_completion(&nv_dev->channel_init_wait);
+	ret = netvsc_wait_for_nvsp_response(dev, nv_dev);
+	if (ret)
+		return ret;
+
 	net_device_ctx->data_path_is_vf = vf;
 
 	return 0;
@@ -429,7 +449,9 @@ static int netvsc_init_buf(struct hv_device *device,
 		goto cleanup;
 	}
 
-	wait_for_completion(&net_device->channel_init_wait);
+	ret = netvsc_wait_for_nvsp_response(device, net_device);
+	if (ret)
+		goto cleanup;
 
 	/* Check the response */
