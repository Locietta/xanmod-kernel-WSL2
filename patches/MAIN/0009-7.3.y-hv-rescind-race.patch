From c879a1fe456f6e62b2609aea989bce32470b020f Mon Sep 17 00:00:00 2001
From: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
Date: Fri, 4 Sep 2026 21:45:24 +0000
Subject: [PATCH 7/9] net: hv_netvsc: give up sub channel setup when no sub
 channel opened

netvsc_sc_open() increments nvdev->open_chn for every sub channel it is
called for, whether or not vmbus_open() succeeded, and
rndis_set_subchannel() only waits for that count to reach num_chn.  The
wait is therefore satisfied even when every single sub channel failed to
open, and setup continues into rndis_filter_set_rss_param(), which blocks
waiting for an RNDIS response from a device that is already gone.  It runs
with RTNL held, so the rescind handler that would make the channel state
visible piles up behind it:

  hv_netvsc ... eth1: sub channel open failed: -122      (x15)

  task:kworker/0:5     state:D
  Workqueue: events netvsc_subchan_work [hv_netvsc]
    rndis_set_rss_param_msg+0x167/0x1c0 [hv_netvsc]
    rndis_filter_set_rss_param+0x21/0x40 [hv_netvsc]
    rndis_set_subchannel+0x2fe/0x450 [hv_netvsc]
    netvsc_subchan_work+0x49/0x130 [hv_netvsc]

  task:kworker/0:1     state:D
  Workqueue: hv_vmbus_rescind vmbus_onmessage_work
    rtnl_lock+0x19/0x20
    netvsc_remove+0x3f/0x210 [hv_netvsc]
    vmbus_onoffer_rescind+0x21e/0x250

Count the sub channels that were actually opened and bail out with -ENODEV
when none of them were, before any further RNDIS request is sent.
netvsc_subchan_work() already falls back to the primary channel on a
non-zero return, and dropping RTNL there lets the rescind handler make
progress again.

Signed-off-by: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
---
 drivers/net/hyperv/hyperv_net.h   |  1 +
 drivers/net/hyperv/rndis_filter.c | 12 ++++++++++++
 2 files changed, 13 insertions(+)

diff --git a/drivers/net/hyperv/hyperv_net.h b/drivers/net/hyperv/hyperv_net.h
index 503f844fe04c..120915554200 100644
--- a/drivers/net/hyperv/hyperv_net.h
+++ b/drivers/net/hyperv/hyperv_net.h
@@ -1207,6 +1207,7 @@ struct netvsc_device {
 	u32 netvsc_gso_max_size;
 
 	atomic_t open_chn;
+	atomic_t open_chn_ok;
 	struct work_struct subchan_work;
 	wait_queue_head_t subchan_open;
 
diff --git a/drivers/net/hyperv/rndis_filter.c b/drivers/net/hyperv/rndis_filter.c
index 3a49721863d2..eb94bcc0e3ea 100644
--- a/drivers/net/hyperv/rndis_filter.c
+++ b/drivers/net/hyperv/rndis_filter.c
@@ -1273,6 +1273,8 @@ static void netvsc_sc_open(struct vmbus_channel *new_sc)
 		netif_queue_set_napi(ndev, chn_index, NETDEV_QUEUE_TYPE_RX,
 				     NULL);
 		netvsc_napi_disable(nvchan);
+	} else {
+		atomic_inc(&nvscdev->open_chn_ok);
 	}
 
 	if (atomic_inc_return(&nvscdev->open_chn) == nvscdev->num_chn)
@@ -1330,6 +1332,15 @@ int rndis_set_subchannel(struct net_device *ndev,
 	wait_event(nvdev->subchan_open,
 		   atomic_read(&nvdev->open_chn) == nvdev->num_chn);
 
+	/*
+	 * open_chn counts the sub channels netvsc_sc_open() was called for,
+	 * not the ones that opened.  If none opened, the device is gone.
+	 */
+	if (nvdev->num_chn > 1 && !atomic_read(&nvdev->open_chn_ok)) {
+		netdev_err(ndev, "no sub channel could be opened, device is gone\n");
+		return -ENODEV;
+	}
+
 	for (i = 0; i < VRSS_SEND_TAB_SIZE; i++)
 		ndev_ctx->tx_table[i] = i % nvdev->num_chn;
 
@@ -1578,6 +1589,7 @@ struct netvsc_device *rndis_filter_device_add(struct hv_device *dev,
 	}
 
 	atomic_set(&net_device->open_chn, 1);
+	atomic_set(&net_device->open_chn_ok, 0);
 	vmbus_set_sc_create_callback(dev->channel, netvsc_sc_open);
 
 	for (i = 1; i < net_device->num_chn; i++) {
