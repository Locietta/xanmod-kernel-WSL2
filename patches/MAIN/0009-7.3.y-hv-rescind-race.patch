From ed9a9a2d0edaa8ab64f05ab637127b46e3996231 Mon Sep 17 00:00:00 2001
From: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
Date: Fri, 4 Sep 2026 21:45:23 +0000
Subject: [PATCH 6/9] net: hv_netvsc: disable a sub channel NAPI exactly once

napi_disable() leaves NAPI_STATE_SCHED set and spins for as long as it is
set, so a second call on the same NAPI never returns.  netvsc_sc_open()
already disables the NAPI of a sub channel whose vmbus_open() failed, so
netvsc_device_remove() disabling it again hangs the CPU:

  hv_netvsc ... eth0: sub channel open failed: -19

  task:kworker/0:1  state:R  running task
    napi_disable+0x2e/0x60
    netvsc_device_remove+0x8f/0x1f0 [hv_netvsc]
    rndis_filter_device_remove+0x1b8/0x200 [hv_netvsc]
    netvsc_remove+0x4e/0x140 [hv_netvsc]

The sub channel fallback in netvsc_subchan_work() has the reverse problem:
it deletes the NAPI of every sub channel, but __netif_napi_del_locked()
warns unless the NAPI was disabled first, and setup can now be given up
after some sub channels have already opened:

  WARNING: CPU: 4 PID: 84 at net/core/dev.c:7751 __netif_napi_del_locked
    __netif_napi_del_locked+0x1f0/0x210
    netvsc_subchan_work+0xd2/0x180 [hv_netvsc]

The two paths are not serialised against each other, so add a per-channel
napi_enabled and claim the disable with an atomic cmpxchg.

Signed-off-by: Erni Sri Satya Vennela <ernis@linux.microsoft.com>
---
 drivers/net/hyperv/hyperv_net.h   | 18 +++++++++++++++++
 drivers/net/hyperv/netvsc.c       | 33 ++++++++++++++++++++++++-------
 drivers/net/hyperv/rndis_filter.c |  3 ++-
 3 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/drivers/net/hyperv/hyperv_net.h b/drivers/net/hyperv/hyperv_net.h
index 4841367fdab2..503f844fe04c 100644
--- a/drivers/net/hyperv/hyperv_net.h
+++ b/drivers/net/hyperv/hyperv_net.h
@@ -1136,6 +1136,7 @@ struct netvsc_channel {
 	void *recv_buf; /* buffer to copy packets out from the receive buffer */
 	const struct vmpacket_descriptor *desc;
 	struct napi_struct napi;
+	atomic_t napi_enabled;
 	struct multi_send_data msd;
 	struct multi_recv_comp mrc;
 	atomic_t queue_sends;
@@ -1149,6 +1150,23 @@ struct netvsc_channel {
 	struct netvsc_stats_rx rx_stats;
 };
 
+/*
+ * Disable a netvsc channel NAPI exactly once.  napi_disable() leaves
+ * NAPI_STATE_SCHED set and spins for as long as it is set, so a second call
+ * never returns, and it spins holding the netdev instance lock, which wedges
+ * every other netdev_lock() user and through them RTNL.  netvsc_sc_open() and
+ * the sub channel setup fallback are not serialised against each other, so
+ * claim the disable atomically.  Return true if this caller performed it.
+ */
+static inline bool netvsc_napi_disable(struct netvsc_channel *nvchan)
+{
+	if (atomic_cmpxchg(&nvchan->napi_enabled, 1, 0) != 1)
+		return false;
+
+	napi_disable(&nvchan->napi);
+	return true;
+}
+
 /* Per netvsc device */
 struct netvsc_device {
 	u32 nvsp_version;
diff --git a/drivers/net/hyperv/netvsc.c b/drivers/net/hyperv/netvsc.c
index 3bc7c1b5a505..dabb3d1ea451 100644
--- a/drivers/net/hyperv/netvsc.c
+++ b/drivers/net/hyperv/netvsc.c
@@ -137,8 +137,19 @@ static void netvsc_subchan_work(struct work_struct *w)
 			netif_device_attach(rdev->ndev);
 		} else {
 			/* fallback to only primary channel */
-			for (i = 1; i < nvdev->num_chn; i++)
-				netif_napi_del(&nvdev->chan_table[i].napi);
+			for (i = 1; i < nvdev->num_chn; i++) {
+				struct netvsc_channel *nvchan =
+					&nvdev->chan_table[i];
+
+				/*
+				 * netif_napi_del() requires the NAPI to be
+				 * disabled, and some sub channels may have
+				 * opened before the setup was aborted.
+				 */
+				netvsc_napi_disable(nvchan);
+
+				netif_napi_del(&nvchan->napi);
+			}
 
 			nvdev->max_chn = 1;
 			nvdev->num_chn = 1;
@@ -761,17 +772,24 @@ void netvsc_device_remove(struct hv_device *device)
 
 	/* Disable NAPI and disassociate its context from the device. */
 	for (i = 0; i < net_device->num_chn; i++) {
+		struct netvsc_channel *nvchan = &net_device->chan_table[i];
+
 		/* See also vmbus_reset_channel_cb(). */
-		/* only disable enabled NAPI channel */
-		if (i < ndev->real_num_rx_queues) {
+		/*
+		 * netvsc_sc_open() already disables the NAPI of a sub channel
+		 * whose vmbus_open() failed, so only disable it if it is still
+		 * enabled.
+		 */
+		if (i < ndev->real_num_rx_queues &&
+		    atomic_read(&nvchan->napi_enabled)) {
 			netif_queue_set_napi(ndev, i, NETDEV_QUEUE_TYPE_TX,
 					     NULL);
 			netif_queue_set_napi(ndev, i, NETDEV_QUEUE_TYPE_RX,
 					     NULL);
-			napi_disable(&net_device->chan_table[i].napi);
+			netvsc_napi_disable(nvchan);
 		}
 
-		netif_napi_del(&net_device->chan_table[i].napi);
+		netif_napi_del(&nvchan->napi);
 	}
 
 	/*
@@ -1868,6 +1886,7 @@ struct netvsc_device *netvsc_device_add(struct hv_device *device,
 	/* Enable NAPI handler before init callbacks */
 	netif_napi_add(ndev, &net_device->chan_table[0].napi, netvsc_poll);
 	napi_enable(&net_device->chan_table[0].napi);
+	atomic_set(&net_device->chan_table[0].napi_enabled, 1);
 	netif_queue_set_napi(ndev, 0, NETDEV_QUEUE_TYPE_RX,
 			     &net_device->chan_table[0].napi);
 	netif_queue_set_napi(ndev, 0, NETDEV_QUEUE_TYPE_TX,
@@ -1915,7 +1934,7 @@ struct netvsc_device *netvsc_device_add(struct hv_device *device,
 cleanup:
 	netif_queue_set_napi(ndev, 0, NETDEV_QUEUE_TYPE_TX, NULL);
 	netif_queue_set_napi(ndev, 0, NETDEV_QUEUE_TYPE_RX, NULL);
-	napi_disable(&net_device->chan_table[0].napi);
+	netvsc_napi_disable(&net_device->chan_table[0]);
 	netif_napi_del(&net_device->chan_table[0].napi);
 
 cleanup2:
diff --git a/drivers/net/hyperv/rndis_filter.c b/drivers/net/hyperv/rndis_filter.c
index 9b6c44979b4e..3a49721863d2 100644
--- a/drivers/net/hyperv/rndis_filter.c
+++ b/drivers/net/hyperv/rndis_filter.c
@@ -1257,6 +1257,7 @@ static void netvsc_sc_open(struct vmbus_channel *new_sc)
 	 * out if napi was not enabled.
 	 */
 	napi_enable(&nvchan->napi);
+	atomic_set(&nvchan->napi_enabled, 1);
 	netif_queue_set_napi(ndev, chn_index, NETDEV_QUEUE_TYPE_RX,
 			     &nvchan->napi);
 	netif_queue_set_napi(ndev, chn_index, NETDEV_QUEUE_TYPE_TX,
@@ -1271,7 +1272,7 @@ static void netvsc_sc_open(struct vmbus_channel *new_sc)
 				     NULL);
 		netif_queue_set_napi(ndev, chn_index, NETDEV_QUEUE_TYPE_RX,
 				     NULL);
-		napi_disable(&nvchan->napi);
+		netvsc_napi_disable(nvchan);
